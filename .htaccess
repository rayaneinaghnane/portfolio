# Apache server configuration for portfolio optimization

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Enable browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML files (check for updates frequently)
    ExpiresByType text/html "access plus 1 week"
    
    # CSS files (cache for longer)
    ExpiresByType text/css "access plus 1 month"
    
    # JavaScript files (cache for longer)
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Image files (cache for extended period)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Font files (cache for extended period)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-otf "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/x-font-woff2 "access plus 1 year"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# Add cache control headers
<IfModule mod_headers.c>
    # Cache HTML for 1 week
    <FilesMatch "\.html$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
    
    # Cache CSS for 1 month
    <FilesMatch "\.css$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # Cache JavaScript for 1 month
    <FilesMatch "\.js$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # Cache images for 1 year
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|webp)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Cache fonts for 1 year
    <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Never cache these
    <FilesMatch "\.(htaccess|htpasswd|ini|phps|fla|psd)$">
        Header set Cache-Control "max-age=0, private, no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Remove ETags (optional - reduces header size)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Prevent directory listing
Options -Indexes

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Remove trailing slashes (optional)
    # RewriteRule ^(.+)/$ /$1 [R=301,L]
    
    # Redirect HTTP to HTTPS (uncomment when on HTTPS)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Redirect www to non-www (uncomment to enforce)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    
    # Prevent access to hidden files and directories
    RewriteRule "^\." - [F]
    RewriteRule "^\..*$" - [F]
</IfModule>

# Set proper MIME types
<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/css css
    AddType image/svg+xml svg svgz
    AddEncoding gzip svgz
    AddType font/ttf ttf
    AddType font/otf otf
    AddType font/woff woff
    AddType font/woff2 woff2
</IfModule>

# Security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Feature Policy / Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Disable server signature
ServerTokens Prod
ServerSignature Off

# Block access to sensitive files
<FilesMatch "\.(json|md|xml|conf|sql|sqlite)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Allow access to static files
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot)$">
    Order allow,deny
    Allow from all
</FilesMatch>
